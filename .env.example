# =====================================================================
# mentoria-board · variáveis de ambiente (modelo, sem valores secretos)
# =====================================================================
# São DOIS arquivos de verdade (nunca vão para o git):
#   web/.env.local   -> app Next.js        (copie o bloco [web])
#   realtime/.env    -> servidor Hocuspocus (copie o bloco [realtime])
#
# Sem as 3 variáveis do Supabase, o app roda em modo dev:
# login só com e-mail, dados em .data/dev-db.json e .data/docs.
#
# Gerar segredos aleatórios (rode no terminal):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# A chave secreta do Supabase pode ser gravada nos dois arquivos sem aparecer na tela:
#   node scripts/set-supabase-secret.mjs


# ---------------------------------------------------------------------
# [web]  ->  web/.env.local
# ---------------------------------------------------------------------

# Endereço público do app (usado nos links de compartilhar e no retorno do login)
APP_URL=http://localhost:3000

# Segredo dos cookies do visitante e do login de dev (texto longo e aleatório)
SESSION_SECRET=

# Segredo compartilhado com o servidor de tempo real: TEM de ser igual ao do [realtime]
REALTIME_SECRET=

# Onde o navegador conecta no tempo real (produção: wss://seu-dominio)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# Opcional: URL HTTP do tempo real para POST /kick e /notify
# (padrão: NEXT_PUBLIC_REALTIME_URL trocando ws por http)
REALTIME_HTTP_URL=

# Supabase: Project Settings > API
#   URL do projeto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   Publishable key (sb_publishable_...) ou a antiga "anon". É pública: vai para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   Secret key (sb_secret_...) ou a antiga "service_role". SÓ no servidor; nunca em NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------
# [realtime]  ->  realtime/.env
# ---------------------------------------------------------------------

# Porta do servidor de tempo real
PORT=1234

# Igual ao REALTIME_SECRET do [web]
REALTIME_SECRET=

# Supabase (mesmos valores do [web]). Sem eles, os docs ficam em .data/docs (modo dev).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Opcional: de quanto em quanto tempo reconferir quem está nos quadros (ms)
RECHECK_MS=30000
