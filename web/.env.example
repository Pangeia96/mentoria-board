APP_URL=http://localhost:3000
# segredo longo e aleatório (cookies do visitante e login de dev)
SESSION_SECRET=
# igual ao do realtime/.env
REALTIME_SECRET=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# Supabase (Project Settings > API). Sem as três, o app roda com dados fake locais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# chave secreta (sb_secret_... ou service_role). Só no servidor; nunca em NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# opcional: URL HTTP do servidor de tempo real para o POST /kick (padrão: NEXT_PUBLIC_REALTIME_URL com http)
REALTIME_HTTP_URL=
