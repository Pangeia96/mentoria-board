{
  "$meta": {
    "name": "mentoria-board",
    "note": "Papéis fixos; /replica-brand troca só os valores. accent é PLACEHOLDER neutro, não é a cor de nenhuma marca.",
    "theme": "light (v1). Canvas claro; dark mode fica para depois."
  },
  "color": {
    "bg": "#F4F5F7",
    "surface": "#FFFFFF",
    "surface-muted": "#F0F1F4",
    "surface-hover": "#E9EBEF",
    "canvas": "#FAFAFB",
    "canvas-grid": "#E2E4E9",
    "border": "#E1E3E8",
    "border-input": "#868C98",
    "text": "#16181D",
    "text-muted": "#555B66",
    "text-subtle": "#636975",
    "accent": "#2F55C9",
    "accent-hover": "#2546AB",
    "accent-soft": "#E8EEFB",
    "on-accent": "#FFFFFF",
    "focus": "#2F55C9",
    "selection": "#2F55C9",
    "danger": "#C42B2B",
    "on-danger": "#FFFFFF",
    "danger-soft": "#FCEBEB",
    "success": "#1E7B45",
    "success-soft": "#E6F4EC",
    "warning": "#8A5A00",
    "warning-soft": "#FFF4DB",
    "overlay": "rgba(22,24,29,0.40)"
  },
  "sticky": {
    "yellow": "#FFF1A6",
    "orange": "#FFD3A8",
    "pink": "#FFC9DD",
    "violet": "#DCCFFF",
    "blue": "#C6DEFF",
    "teal": "#BFEDE4",
    "green": "#D3F0B8",
    "gray": "#E6E7EB",
    "ink": "#16181D"
  },
  "presence": {
    "p1": "#C2410C",
    "p2": "#B91C5C",
    "p3": "#7C3AED",
    "p4": "#1D4ED8",
    "p5": "#0F766E",
    "p6": "#15803D",
    "p7": "#A16207",
    "p8": "#475569",
    "on-presence": "#FFFFFF"
  },
  "font": {
    "family-sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "family-hand": "'Kalam', 'Comic Neue', cursive",
    "weight-regular": 400,
    "weight-medium": 500,
    "weight-semibold": 600
  },
  "size": {
    "xs":  { "font": "12px", "line": "16px" },
    "sm":  { "font": "14px", "line": "20px" },
    "md":  { "font": "16px", "line": "24px" },
    "lg":  { "font": "20px", "line": "28px" },
    "xl":  { "font": "28px", "line": "36px" },
    "2xl": { "font": "40px", "line": "48px" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "6px", "md": "8px", "lg": "12px", "full": "9999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(22,24,29,0.08)",
    "md": "0 2px 8px rgba(22,24,29,0.10), 0 0 0 1px rgba(22,24,29,0.04)",
    "lg": "0 12px 32px rgba(22,24,29,0.16), 0 0 0 1px rgba(22,24,29,0.04)",
    "sticky": "0 1px 1px rgba(22,24,29,0.06), 0 4px 10px rgba(22,24,29,0.10)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "header-h": "56px",
    "toolbar-w": "48px",
    "toolbar-btn": "40px",
    "drawer-w": "360px",
    "dashboard-max": "1200px",
    "bp-sm": "640px",
    "bp-md": "768px",
    "bp-lg": "1024px",
    "z-canvas": 0,
    "z-cursors": 10,
    "z-chrome": 20,
    "z-drawer": 30,
    "z-modal": 40,
    "z-toast": 50
  },
  "pairs": [
    ["text", "bg", "body"],
    ["text", "surface", "body"],
    ["text", "surface-muted", "body"],
    ["text", "surface-hover", "body"],
    ["text", "canvas", "body"],
    ["text-muted", "surface", "body"],
    ["text-muted", "bg", "body"],
    ["text-muted", "surface-muted", "body"],
    ["text-muted", "surface-hover", "body"],
    ["text-subtle", "surface", "body"],
    ["text-subtle", "bg", "body"],
    ["text-subtle", "surface-muted", "body"],
    ["on-accent", "accent", "body"],
    ["on-accent", "accent-hover", "body"],
    ["accent", "surface", "body"],
    ["accent", "accent-soft", "body"],
    ["on-danger", "danger", "body"],
    ["danger", "surface", "body"],
    ["danger", "danger-soft", "body"],
    ["success", "surface", "body"],
    ["success", "success-soft", "body"],
    ["warning", "surface", "body"],
    ["warning", "warning-soft", "body"],
    ["border-input", "surface", "ui"],
    ["focus", "surface", "ui"],
    ["focus", "bg", "ui"],
    ["selection", "canvas", "ui"],
    ["sticky.ink", "sticky.yellow", "body"],
    ["sticky.ink", "sticky.orange", "body"],
    ["sticky.ink", "sticky.pink", "body"],
    ["sticky.ink", "sticky.violet", "body"],
    ["sticky.ink", "sticky.blue", "body"],
    ["sticky.ink", "sticky.teal", "body"],
    ["sticky.ink", "sticky.green", "body"],
    ["sticky.ink", "sticky.gray", "body"],
    ["presence.on-presence", "presence.p1", "body"],
    ["presence.on-presence", "presence.p2", "body"],
    ["presence.on-presence", "presence.p3", "body"],
    ["presence.on-presence", "presence.p4", "body"],
    ["presence.on-presence", "presence.p5", "body"],
    ["presence.on-presence", "presence.p6", "body"],
    ["presence.on-presence", "presence.p7", "body"],
    ["presence.on-presence", "presence.p8", "body"],
    ["presence.p1", "canvas", "ui"],
    ["presence.p7", "canvas", "ui"]
  ]
}
